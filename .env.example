RABBITMQ_DEFAULT_USER=tfinder
RABBITMQ_DEFAULT_PASS=tfinder

JWT_SECRET=change-me-en-produccion
JWT_EXP_MIN=1440

# --- Envío real de correos (registro/recuperación) ---------------------------
# Ejemplo Gmail: host smtp.gmail.com, puerto 465 (SSL, MAIL_SECURE=ssl) y
# SMTP_PASSWORD con una CONTRASEÑA DE APLICACIÓN de 16 dígitos
# (myaccount.google.com/apppasswords; no la contraseña normal de tu cuenta).
# Ejemplo Brevo/SendGrid SMTP: host/puerto 587 (MAIL_SECURE=tls) y su SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=TFinder
MAIL_SECURE=tls

SESSION_IDLE_MIN=30
QR_SECRET=change-me-qr-secret
MESAS_EMAIL=email_svc@tfinder.dev
# MESAS_PASSWORD= (solo si usas scripts/bootstrap_service_account.py)
RATE_LIMIT_PER_MIN=100
DEBUG=false

VITE_API_URL=http://localhost:8001