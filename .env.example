# API (cada servicio usa la variable PROPIA de base; ver defaults por servicio
# en mesas_api/app/db.py, builds_api/app/db.py, feed_api/app/db.py, notif_api/app/db.py)
PORT=8001

# PostgreSQL (B02: un servicio = un pool = una *"_db"*). Cada servicio lee su
# variable (MESAS_DATABASE_URL, BUILDS_DATABASE_URL, FEED_DATABASE_URL,
# NOTIF_DATABASE_URL); si no está definida usa su default local (ver db.py).
#   - desarrollo local (host): <VAR>=postgresql://tfinder:tfinder@localhost:5432/<db>
#   - dentro de compose:       <VAR>=postgresql://tfinder:tfinder@postgres:5432/<db>
# DATABASE_URL (legacy AE1) se conserva solo para herramientas locales (psql).
PGSQL_HOST=localhost
PGSQL_PORT=5432
PGSQL_USER=tfinder
PGSQL_PASSWORD=tfinder
DATABASE_URL=postgresql://tfinder:tfinder@localhost:5432/mesas_db

# Redis
REDIS_URL=redis://localhost:6390/0

# RabbitMQ
RABBITMQ_URL=amqp://tfinder:tfinder@localhost:5673/

# JWT
JWT_SECRET=change-me-en-produccion
JWT_EXP_MIN=1440

# Email sandbox (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@tfinder.local

# Frontend
VITE_API_URL=http://localhost:8001