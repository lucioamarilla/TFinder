# Same-origin en el dev server de Vite: cada /<servicio>-api que pasa por el
# proxy (ver vite.config.js) hacia el API correspondiente en localhost.
VITE_MESAS_API=/mesas-api
VITE_BUILDS_API=/builds-api
VITE_FEED_API=/feed-api
VITE_NOTIF_API=/notif-api
# Sesion real contra mesas-api (JWT Bearer). Ponelo en "demo" para trabajar
# sin los 4 backends levantados (pantallas demo autónomas).
VITE_AUTH_MODE=api
# Servicios de negocio reales (mesas/fechas/wiki/feed/notificaciones). En "demo"
# queda el simulador local para los tests unitarios.
VITE_API_MODE=api
